# Copy to `.env` and fill in real values. Never commit `.env`.
# Keys read through src/lib/env.ts unless noted otherwise.

# --- Core ---
DATABASE_URL=postgresql://user:password@host:5432/dbname   # read directly in src/lib/db.ts
JWT_SECRET=                                                # 32+ random chars; read in src/lib/auth.ts
COOKIE_SECURE=false
NODE_ENV=development
SITE_URL=https://www.newsicons.com                         # read in src/config/site.ts

# --- Object storage (S3 / CloudFront) ---
# Leave the access keys blank in environments where an EC2/ECS IAM role is
# attached — the AWS SDK default provider chain will be used automatically.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
# CLOUDFRONT_URL=https://xxxxxxxx.cloudfront.net

# --- Article generation pipeline ---
GENERATE_CONTENT_API=            # external EC2 service that writes article text
OPENAI_API_KEY=                  # featured / article image generation
XPOZ_API_KEY=                    # X/Twitter scraping
# XPOZ_SERVER_URL=
APIFY_API_TOKEN=                 # video transcription for X-monitoring content
SUPADATA_API_KEY=               # YouTube transcript fetch
MEDIASTACK_API_KEY=            # news-source article fetch
CRAWL_API_URL=                   # crawler service start endpoint
CRAWL_STOP_API_URL=              # crawler service stop endpoint
EXTERNAL_API_WEBHOOK_SECRET=     # HMAC secret for the inbound external-article webhook

# --- Other integrations ---
RESEND_API_KEY=                  # newsletter OTP email
YOUTUBE_API_V3_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # alternate image-upload path

# --- Optional OpenAI image tuning (parsed in src/lib/openaiImages.ts) ---
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_SIZE=
# OPENAI_IMAGE_STYLE_PRESET=
# OPENAI_IMAGE_INPUT_FIDELITY=
